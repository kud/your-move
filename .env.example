# The key the session cookie is sealed under. Any long random string; changing
# it signs everyone out, which is also how you revoke every session at once.
#   openssl rand -base64 48
SESSION_SECRET=

# From a GitHub OAuth App — https://github.com/settings/developers
# Its "Authorization callback URL" must be <your-deployment>/api/auth/callback
#
# Deliberately an OAuth App rather than a GitHub App: a GitHub App's user token
# is intersected with the App's installations, so it would only ever see the
# repos the App happens to be installed on.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
